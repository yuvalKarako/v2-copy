1:["$","main",null,{"id":"main","className":"wrap inner-page","children":[["$","div",null,{"className":"page-heading","children":[["$","p",null,{"className":"eyebrow","children":"RESEARCH · TEACHING · PUBLIC SERVICE"}],["$","h1",null,{"children":"The work."}],["$","p",null,{"children":"Three roles: graduate research in AI & Biotechnology at Bar-Ilan University, teaching agentic AI to its senior faculty, and digital transformation in the IDF."}]]}],["$","div",null,{"className":"work-grid","children":[["$","article","research",{"className":"work-summary","children":[["$","p",null,{"className":"eyebrow","children":["RESEARCH"," / ","FIVE RESEARCH LINES · THESIS IN EVALUATION"]}],["$","h2",null,{"children":["$","a",null,{"href":"/v2-copy/work/research","children":"Research"}]}],["$","p",null,{"children":"My M.Sc. thesis builds an AI system that goes past labeling underwater images. It measures each coral, follows it over time, and when it finds damage, proposes likely causes based on 845 scientific papers. Most existing tools stop at the labeling step. Around it: a BIU AI Convergence grant with Prof. Carmit Altman, a systematic review, and a collaboration with the Technion."}],["$","div",null,{"className":"work-meta mono","children":"M.Sc. Biotechnology · Marine Ecosystem Dynamics Lab (Dr. Gal Eyal) · Bar-Ilan University"}],["$","a",null,{"className":"text-link","href":"/v2-copy/work/research","children":["The research",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}],["$","article","teaching",{"className":"work-summary","children":[["$","p",null,{"className":"eyebrow","children":["TEACHING"," / ","THIRD COHORT · 2026"]}],["$","h2",null,{"children":["$","a",null,{"href":"/v2-copy/work/teaching","children":"Teaching agentic AI"}]}],["$","p",null,{"children":"I’m on the teaching faculty of HIGH AI, Bar-Ilan University’s flagship program for training senior academics in agentic AI. I teach its unit on building a personal knowledge base to deans, department heads and research-institute directors."}],["$","div",null,{"className":"work-meta mono","children":"Teaching faculty · HIGH AI · Bar-Ilan University"}],["$","a",null,{"className":"text-link","href":"/v2-copy/work/teaching","children":["The method",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}],["$","article","public-service",{"className":"work-summary","children":[["$","p",null,{"className":"eyebrow","children":["PUBLIC SERVICE"," / ","CURRENT ROLE"]}],["$","h2",null,{"children":["$","a",null,{"href":"/v2-copy/work/public-service","children":"Digital transformation in the IDF"}]}],["$","p",null,{"children":"I head digital transformation in the IDF Education & Youth Corps. I find problems the Corps already has that technology can solve, define the product, and take it to a working demonstration, without adding budget or headcount."}],["$","div",null,{"className":"work-meta mono","children":"Head of Digital Transformation · IDF Education & Youth Corps"}],["$","a",null,{"className":"text-link","href":"/v2-copy/work/public-service","children":["The role",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}]]}]]}]
