3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Professional profile — Yuval Karako"}],["$","meta","1",{"name":"description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology (M.Sc.) at Bar-Ilan University's Marine Ecosystem Dynamics Lab, where he leads an AI research project that moves from detecting ecological change to explaining its causes. He is the AI research lead on a 2026 BIU AI Convergence seed grant with Prof. Carmit Altman and Dr. Gal Eyal. He teaches agentic AI and personal knowledge bases to senior faculty in HIGH AI, Bar-Ilan's flagship AI program for academics, and leads digital transformation in the IDF Education & Youth Corps."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","meta","3",{"property":"og:title","content":"Yuval Karako — Professional profile"}],["$","meta","4",{"property":"og:description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology (M.Sc.) at Bar-Ilan University's Marine Ecosystem Dynamics Lab, where he leads an AI research project that moves from detecting ecological change to explaining its causes. He is the AI research lead on a 2026 BIU AI Convergence seed grant with Prof. Carmit Altman and Dr. Gal Eyal. He teaches agentic AI and personal knowledge bases to senior faculty in HIGH AI, Bar-Ilan's flagship AI program for academics, and leads digital transformation in the IDF Education & Youth Corps."}],["$","meta","5",{"property":"og:type","content":"profile"}],["$","meta","6",{"name":"twitter:card","content":"summary"}],["$","meta","7",{"name":"twitter:title","content":"Yuval Karako — Graduate Researcher in AI & Biotechnology, Bar-Ilan University"}],["$","meta","8",{"name":"twitter:description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology at Bar-Ilan University, leading an AI research project on automated monitoring of marine ecosystems. He designs and teaches agentic-AI practice for Bar-Ilan's senior academic leadership, and heads digital transformation in the IDF Education & Youth Corps."}],["$","link","9",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/v2-copy/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","10",{"rel":"canonical","href":"https://yuvalkarako.github.io/v2-copy/profile"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["profile"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"profile","fallback":["$","main",null,{"id":"main","className":"wrap not-found","children":[["$","p",null,{"className":"eyebrow","children":"404 — PAGE NOT FOUND"}],["$","h1",null,{"children":"This page isn’t here."}],["$","p",null,{"children":"There is still plenty to explore."}],["$","a",null,{"className":"text-link","href":"/v2-copy/","children":["Back to the beginning",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]]}],"children":["$","$La",null,{"resetKey":"[\"profile\"]","fallback":["$","main",null,{"id":"main","className":"wrap not-found","children":[["$","p",null,{"className":"eyebrow","children":"404 — PAGE NOT FOUND"}],["$","h1",null,{"children":"This page isn’t here."}],["$","p",null,{"children":"There is still plenty to explore."}],["$","a",null,{"className":"text-link","href":"/v2-copy/","children":["Back to the beginning",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m