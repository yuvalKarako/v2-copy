e:T63e,{"@context":"https://schema.org","@type":"ProfilePage","url":"https://yuvalkarako.github.io/v2-copy/profile","dateModified":"2026-10-06","mainEntity":{"@context":"https://schema.org","@type":"Person","@id":"https://yuvalkarako.github.io/v2-copy/#person","name":"Yuval Karako","alternateName":"יובל קרקו","url":"https://yuvalkarako.github.io/v2-copy/profile","image":"https://yuvalkarako.github.io/v2-copy/media/portrait.webp","description":"Yuval Karako is a graduate researcher in AI & Biotechnology (M.Sc.) at Bar-Ilan University's Marine Ecosystem Dynamics Lab, where he leads an AI research project that moves from detecting ecological change to explaining its causes. He is the AI research lead on a 2026 BIU AI Convergence seed grant with Prof. Carmit Altman and Dr. Gal Eyal. He teaches agentic AI and personal knowledge bases to senior faculty in HIGH AI, Bar-Ilan's flagship AI program for academics, and leads digital transformation in the IDF Education & Youth Corps.","jobTitle":["Graduate Researcher in AI & Biotechnology, Bar-Ilan University","Head of Digital Transformation, IDF Education & Youth Corps","Teaching Faculty, HIGH AI"],"award":["BIU AI Convergence seed grant, 2026"],"affiliation":{"@type":"CollegeOrUniversity","name":"Bar-Ilan University","url":"https://www.biu.ac.il/en"},"sameAs":["https://www.linkedin.com/in/yuvalkarako/","https://github.com/yuvalKarako"],"knowsAbout":["Causal reasoning with AI","Retrieval-augmented generation","Computer vision for underwater imagery","Marine ecology","Agentic AI adoption","LLM knowledge bases","Product management"]}}1:["$","main",null,{"id":"main","className":"wrap inner-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$e"}}],["$","div",null,{"className":"page-heading","children":[["$","p",null,{"className":"eyebrow","children":"THE PROFESSIONAL PROFILE"}],["$","h1",null,{"children":["Yuval Karako",["$","span",null,{"className":"brand-dot","children":"."}]]}],["$","p",null,{"children":["Graduate Researcher in AI & Biotechnology, Bar-Ilan University.",["$","br",null,{}],"Teaching faculty, HIGH AI. Head of Digital Transformation, IDF Education & Youth Corps."]}]]}],["$","div",null,{"className":"profile-layout","children":[["$","nav",null,{"className":"profile-nav","aria-label":"Profile sections","children":[["$","span",null,{"className":"mono","children":"IN THIS PROFILE"}],["$","a",null,{"href":"#bio","children":"Biography"}],["$","a",null,{"href":"#roles","children":"Current work"}],["$","a",null,{"href":"#selected-work","children":"Selected work"}],["$","a",null,{"href":"#hebrew","children":"עברית"}],["$","a",null,{"href":"#profile-contact","children":"Contact"}],["$","a",null,{"href":"/v2-copy/profile.md","children":"Markdown ↗"}],["$","$Lf",null,{}]]}],["$","div",null,{"className":"profile-content","children":[["$","section",null,{"id":"bio","children":[["$","h2",null,{"children":"Biography"}],["$","p",null,{"children":"Yuval Karako is a graduate researcher in AI & Biotechnology (M.Sc.) at Bar-Ilan University's Marine Ecosystem Dynamics Lab, where he leads an AI research project that moves from detecting ecological change to explaining its causes. He is the AI research lead on a 2026 BIU AI Convergence seed grant with Prof. Carmit Altman and Dr. Gal Eyal. He teaches agentic AI and personal knowledge bases to senior faculty in HIGH AI, Bar-Ilan's flagship AI program for academics, and leads digital transformation in the IDF Education & Youth Corps."}],["$","p",null,{"children":"Earlier, he was a product manager in the IDF (2020–22), a member of the third cohort of Amiti's Nurture community for aspiring founders (2024–25), and co-founder of Kory Game Studios, which published two mobile games."}]]}],"$L10","$L11","$L12","$L13"]}]]}]]}]
10:["$","section",null,{"id":"roles","children":[["$","h2",null,{"children":"Current work"}],["$","dl",null,{"children":[["$","dt",null,{"children":["$","h3",null,{"children":"Graduate Researcher · AI & Biotechnology"}]}],["$","dd",null,{"children":"Bar-Ilan University, Marine Ecosystem Dynamics Lab. AI that explains ecological change in coral reefs."}],["$","dt",null,{"children":["$","h3",null,{"children":"AI research lead · BIU AI Convergence seed grant"}]}],["$","dd",null,{"children":"With Prof. Carmit Altman and Dr. Gal Eyal, 2026–27."}],["$","dt",null,{"children":["$","h3",null,{"children":"Head of Digital Transformation · IDF Education & Youth Corps"}]}],["$","dd",null,{"children":"Product definition and technology adoption across the Corps, within the existing budget."}],["$","dt",null,{"children":["$","h3",null,{"children":"Teaching faculty · HIGH AI"}]}],["$","dd",null,{"children":"Bar-Ilan University. Teaching agentic AI and personal knowledge bases to deans, department heads and research-institute directors."}]]}]]}]
11:["$","section",null,{"id":"selected-work","children":[["$","h2",null,{"children":"Selected work"}],[["$","article","research",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/v2-copy/work/research","children":["Research",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"My M.Sc. thesis builds an AI system that goes past labeling underwater images. It measures each coral, follows it over time, and when it finds damage, proposes likely causes based on 845 scientific papers. Most existing tools stop at the labeling step. Around it: a BIU AI Convergence grant with Prof. Carmit Altman, a systematic review, and a collaboration with the Technion."}]]}],["$","article","teaching",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/v2-copy/work/teaching","children":["Teaching agentic AI",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"I’m on the teaching faculty of HIGH AI, Bar-Ilan University’s flagship program for training senior academics in agentic AI. I teach its unit on building a personal knowledge base to deans, department heads and research-institute directors."}]]}],["$","article","public-service",{"className":"profile-work","children":[["$","h3",null,{"children":["$","a",null,{"className":"text-link","href":"/v2-copy/work/public-service","children":["Digital transformation in the IDF",["$","svg",null,{"className":"arrow","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","children":["$","path",null,{"d":"M4 12h15m-6-6 6 6-6 6","stroke":"currentColor","strokeWidth":"1.4","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}]}],["$","p",null,{"children":"I head digital transformation in the IDF Education & Youth Corps. I find problems the Corps already has that technology can solve, define the product, and take it to a working demonstration, without adding budget or headcount."}]]}]]]}]
12:["$","section",null,{"id":"hebrew","lang":"he","dir":"rtl","children":[["$","h2",null,{"children":"יובל קרקו"}],["$","p",null,{"children":"יובל קרקו הוא חוקר לתואר שני בביוטכנולוגיה במעבדה לדינמיקה של מערכות אקולוגיות ימיות באוניברסיטת בר־אילן, ומפתח מערכות בינה מלאכותית שעוברות מזיהוי של שינויים אקולוגיים להסבר הגורמים להם. הוא מוביל את מחקר ה־AI במענק BIU AI Convergence לשנת 2026, יחד עם פרופ׳ כרמית אלטמן וד״ר גל אייל. הוא חבר בסגל ההוראה של HIGH AI, תוכנית הדגל של בר־אילן להכשרת אקדמאים בכירים בבינה מלאכותית, ומוביל את הטרנספורמציה הדיגיטלית בחיל החינוך והנוער."}]]}]
