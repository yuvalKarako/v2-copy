3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"AI that explains ecological change — Yuval Karako"}],["$","meta","1",{"name":"description","content":"My M.Sc. thesis builds an AI system that goes past labeling underwater images. It measures each coral, follows it over time, and when it finds damage, proposes likely causes based on 845 scientific papers. Most existing tools stop at the labeling step."}],["$","meta","2",{"name":"robots","content":"noindex, nofollow"}],["$","meta","3",{"property":"og:title","content":"AI that explains ecological change — Yuval Karako"}],["$","meta","4",{"property":"og:description","content":"My M.Sc. thesis builds an AI system that goes past labeling underwater images. It measures each coral, follows it over time, and when it finds damage, proposes likely causes based on 845 scientific papers. Most existing tools stop at the labeling step."}],["$","meta","5",{"property":"og:url","content":"https://yuvalkarako.github.io/v2-copy/work/research"}],["$","meta","6",{"name":"twitter:card","content":"summary"}],["$","meta","7",{"name":"twitter:title","content":"Yuval Karako — Graduate Researcher in AI & Biotechnology, Bar-Ilan University"}],["$","meta","8",{"name":"twitter:description","content":"Yuval Karako is a graduate researcher in AI & Biotechnology at Bar-Ilan University, leading an AI research project on automated monitoring of marine ecosystems. He designs and teaches agentic-AI practice for Bar-Ilan's senior academic leadership, and heads digital transformation in the IDF Education & Youth Corps."}],["$","link","9",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/v2-copy/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}],["$","link","10",{"rel":"canonical","href":"https://yuvalkarako.github.io/v2-copy/work/research"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",nul